rules_version = '2';

// Aturan keamanan Firestore StudyFlow.
// - Profil: tiap user hanya akses dokumennya sendiri (users/{uid}). Field
//   sensitif (uid/email/createdAt) tidak boleh diubah; role divalidasi.
// - Forum: publik (baca) untuk user login; tulis dengan data valid.
//   replyCount topik boleh di-increment user mana pun (kolaboratif), namun
//   field identitas (authorId/title/content) tidak boleh berubah.
// Lihat documentation/PROGRESS.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helper: cek field string non-kosong =====
    function isNonEmptyStr(v) {
      return v is string && v.size() > 0;
    }

    // ===== Profil pengguna =====
    match /users/{uid} {
      allow read: if request.auth != null;

      // Tulis profil: hanya pemilik. Field identitas immutable; role divalidasi.
      allow write: if request.auth != null
        && request.auth.uid == uid
        // uid & email tidak boleh diubah (sumber kebenaran = Auth).
        && (!('uid' in request.resource.data.diff(resource.data).affectedKeys())
            || resource.data.uid == uid)
        && (!('email' in request.resource.data.diff(resource.data).affectedKeys())
            || resource.data.email == resource.data.email)
        // role hanya boleh nilai enum yang sah (jika disertakan).
        && (!('role' in request.resource.data)
            || request.resource.data.role in
              ['siswa', 'mahasiswa', 'guru', 'umum']);
    }

    // ===== Papan peringkat (leaderboard) =====
    // Tiap user hanya menulis doc miliknya (uid). Field uid/weekId immutable
    // (anti curi slot peringkat orang lain). Baca publik untuk user login.
    match /progress/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && isNonEmptyStr(request.resource.data.weekId)
        && request.resource.data.weeklyXp is int
        && request.resource.data.weeklyXp >= 0;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.weekId is string
        && request.resource.data.weeklyXp is int
        && request.resource.data.weeklyXp >= 0;
      // Hapus doc peringkat milik sendiri (pemenuhan account deletion).
      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // ===== Forum diskusi (PRD §5.6) =====
    match /forum_topics/{topicId} {
      allow read: if request.auth != null;

      // Buat topik: harus login & authorId = uid sendiri + field wajib.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && isNonEmptyStr(request.resource.data.title)
        && isNonEmptyStr(request.resource.data.content)
        // Anti-spam: batas panjang judul/isi.
        && request.resource.data.title.size() <= 120
        && request.resource.data.content.size() <= 10000;

      // Update: hanya untuk menambah replyCount (transaksi client). Field
      // identitas topik harus tetap sama.
      allow update: if request.auth != null
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.title == resource.data.title
        && request.resource.data.content == resource.data.content;

      // Hapus topik: hanya pembuat (authorId == uid login).
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.authorId;

      // Balasan
      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && isNonEmptyStr(request.resource.data.content)
          && request.resource.data.content.size() <= 5000;
        // Hapus balasan: pemilik balasan ATAU pembuat topik (moderasi saat
        // menghapus topik — cascade). Dipakai deleteTopic untuk membersihkan
        // seluruh balasan topik.
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.authorId
              || request.auth.uid ==
                  get(/databases/$(database)/documents/forum_topics/$(topicId)).data.authorId);
        allow update: if false;
      }
    }

    // ===== Grup belajar (FEATURE_ROADMAP #11) =====
    // Grup dapat dibaca semua user login (penemuan). Keanggotaan via
    // subkoleksi members/{uid}; pesan hanya untuk anggota. memberCount
    // dijaga konsisten oleh aturan (hanya boleh berubah saat join/leave).
    match /study_groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && isNonEmptyStr(request.resource.data.name)
        && request.resource.data.name.size() <= 80
        && request.resource.data.memberCount is int
        && request.resource.data.memberCount == 1;
      // Update: hanya memberCount yang boleh berubah (join/leave batch).
      allow update: if request.auth != null
        && request.resource.data.name == resource.data.name
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.description == resource.data.description
        && request.resource.data.memberCount is int;
      // Hapus grup: hanya pembuat (cascade members & messages).
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;

      match /members/{uid} {
        allow read: if request.auth != null;
        // Bergabung: hanya uid sendiri (field uid disimpan untuk kemudahan
        // penghapusan akun via collectionGroup).
        allow create: if request.auth != null
          && request.auth.uid == uid;
        // Keluar: hanya uid sendiri.
        allow delete: if request.auth != null
          && request.auth.uid == uid;
        allow update: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid));
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && isNonEmptyStr(request.resource.data.content)
          && request.resource.data.content.size() <= 2000
          && exists(/databases/$(database)/documents/study_groups/$(groupId)/members/$(request.auth.uid));
        // Hapus: pembuat pesan ATAU pembuat grup (cascade/ moderasi).
        allow delete: if request.auth != null
          && (request.auth.uid == resource.data.authorId
              || request.auth.uid ==
                  get(/databases/$(database)/documents/study_groups/$(groupId)).data.ownerUid);
        allow update: if false;
      }
    }
  }
}
